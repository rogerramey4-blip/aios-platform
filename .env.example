# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-random-32-char-string

# ── Encryption at rest (AES-256 via Fernet HKDF) ────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── SMTP email delivery (works on Render; Railway blocks outbound SMTP) ──────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@aievolutionservices.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=support@aievolutionservices.com

# ── Hosting / custom domain routing ──────────────────────────────────────────
APP_HOSTNAME=your-app.railway.app

# ── AI (for document classification) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# PRODUCTION: set DATABASE_URL to a managed Postgres. Railway/Render container
# filesystems are EPHEMERAL — SQLite is wiped on every redeploy, losing all data.
# On Railway: add a Postgres plugin and reference it, e.g.
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Local-dev fallback only (used when DATABASE_URL is unset):
TENANT_DB_PATH=aios_tenants.db
