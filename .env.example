# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-random-32-char-string

# ── Encryption at rest (AES-256 via Fernet HKDF) ────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── SMTP email delivery (works on Render; Railway blocks outbound SMTP) ──────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@aievolutionservices.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=support@aievolutionservices.com

# ── Hosting / custom domain routing ──────────────────────────────────────────
APP_HOSTNAME=your-app.railway.app

# ── AI (for document classification) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database (defaults to aios_tenants.db in project root) ───────────────────
TENANT_DB_PATH=aios_tenants.db
